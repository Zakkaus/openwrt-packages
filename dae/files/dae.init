#!/bin/sh /etc/rc.common
#
# OpenWrt procd init script for dae.
#
# UCI (/etc/config/dae):
#
#   config dae 'config'
#       option enabled '0'
#       option config_file '/etc/dae/config.dae'
#
# dae runs as root because its eBPF datapath attaches to the LAN/WAN
# interfaces and creates the daens network namespace.

USE_PROCD=1
START=99
STOP=01

CONF="dae"
PROG="/usr/bin/dae"

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "config" "enabled" 0
	[ "$enabled" -eq 1 ] || return 1

	local config_file
	config_get config_file "config" "config_file" "/etc/dae/config.dae"

	if [ ! -r "$config_file" ]; then
		logger -t dae "configuration file '$config_file' is missing or unreadable"
		return 1
	fi

	# `validate` runs the same rule pipeline as `run` (alias resolution,
	# geosite/geoip expansion, rule lowering) without touching the eBPF
	# datapath, so a broken configuration fails before the running instance
	# is replaced. Geo assets are resolved locally, never downloaded.
	if ! "$PROG" validate -c "$config_file"; then
		logger -t dae "configuration '$config_file' failed validation"
		return 1
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run --config "$config_file"
	# dae budgets its flow tables from RLIMIT_NOFILE, so keep the hard limit high
	procd_set_param limits core="unlimited" nofile="1000000 1000000"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# dae reloads on SIGHUP and keeps established connections.
	procd_send_signal "$CONF" "$CONF" 1
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
